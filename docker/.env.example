# ─────────────────────────────────────────────────────────────
# WorkBuddy 每日助手 —— 环境变量（复制成 .env 再改）
#   cp .env.example .env && vi .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────

# 【必填】Web 控制台登录密码。设成强密码，别用默认值。
WEB_PASSWORD=change-me-please

# 【必填】会话签名密钥，>=16 字符。生成：
#   python3 -c "import secrets;print(secrets.token_hex(32))"
WEB_SECRET=change-me-to-a-random-64-char-hex-string

# 定时任务时间（标准 cron 五段式，容器内按 Asia/Shanghai 解释）
# 默认每天 7:30、13:30、17:30 各跑一次
CRON_SCHEDULE=30 7,13,17 * * *

# Web 监听端口（容器内部端口，改完记得同步改 compose 的映射）
WEB_PORT=8080
WEB_HOST=0.0.0.0

# 数据目录（容器内路径，compose 已映射到宿主 /vol1/docker/workbuddy/data）
DATA_DIR=/data

# 时区，必须保持 Asia/Shanghai，否则 cron 时间点会偏 8 小时
TZ=Asia/Shanghai

# ⚠️ 不要设置 WB_ACCOUNTS_JSON！它的优先级高于账号文件，
#    一旦设置会把 Web 界面添加的账号全部遮蔽掉。
#    账号请在 Web 控制台的「账号」页里添加。
