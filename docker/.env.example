# ─────────────────────────────────────────────────────────────
# WorkBuddy 每日助手 —— 环境变量（复制成 .env 再改）
#   cp .env.example .env && vi .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────

# 【必填】Web 控制台登录密码。设成强密码，别用默认值。
WEB_PASSWORD=change-me-please

# 【必填】会话签名密钥，>=16 字符。生成：
#   python3 -c "import secrets;print(secrets.token_hex(32))"
WEB_SECRET=change-me-to-a-random-64-char-hex-string

# 定时任务时间（标准 cron 五段式，容器内按 Asia/Shanghai 解释）
# 默认每天 7:30、13:30、17:30 各跑一次
CRON_SCHEDULE=30 7,13,17 * * *

# Web 监听端口（容器内部端口，改完记得同步改 compose 的映射）
WEB_PORT=8080
WEB_HOST=0.0.0.0

# 数据目录（容器内路径，compose 已映射到宿主 /vol1/docker/workbuddy/data）
DATA_DIR=/data

# 时区，必须保持 Asia/Shanghai，否则 cron 时间点会偏 8 小时
TZ=Asia/Shanghai

# ─── 成长中心「连续登录」───────────────────────────────────────
# 连登 = 连续登录且使用 WorkBuddy 的天数；每天的签到动作即等价于「登录并使用」。
# 档位：入门档 7 天 / 进阶档 14 天 / 巅峰档 28 天，每档每月限兑 1 次。
#
# 总开关：0 = 完全跳过连登/成长相关逻辑（不发起任何请求）
WB_GROWTH=1

# 连登奖励兑换：1 = 自动兑换已达档位且本月未兑的奖励（默认开）
#   服务端有「每档每月限 1 次」硬约束，重复调用会被挡，误操作风险低。
WB_STREAK_REDEEM=1

# 补登卡：1 = 自动用补登卡补当月断登（默认关）
#   ⚠️ 补登卡上限 4 张、永久持有、不可逆，且补哪天最划算尚无定论 → 默认不动。
#   保持 0 时只在报告里显示余额，不做任何写入。
WB_STREAK_MAKEUP=0

# ─── Token / 积分用量 ──────────────────────────────────────────
# 每天读一次「每日用量」，展示在报告里（纯只读，不消耗任何额度）。
# 口径：CodeBuddy 采用积分计费，模型调用按系数扣积分 —— 所以这是**积分消耗**，
#       不是原始 token 数。官方提示数据有 2-3 小时延迟，当天数字偏小属正常。
# 总开关：0 = 完全不请求用量接口
WB_USAGE=1

# 用量窗口天数（1~31，前端硬上限就是 31 天）
WB_USAGE_DAYS=7

# ─── 用量看板自动采集 ──────────────────────────────────────────
# 容器里每天自动跑一次「用量采集」（只读），结果落 data/usage_history.json，
# 控制台「用量」页直接读它画看板。和上面的 WB_USAGE 是**两件事**：
#   WB_USAGE      → 签到一起跑（一天三次），顺手把用量写进每日归档
#   USAGE_CRON    → 独立的采集任务，窗口更长、专门喂看板
#
# 采集时间（cron 表达式，容器内 TZ 生效）。默认每天早上 8:10：
USAGE_CRON=10 8 * * *
# 想多采几次、或换时间，直接改这里，例如：
#   USAGE_CRON=0 */6 * * *        # 每 6 小时一次
#   USAGE_CRON=30 7 * * 1-5       # 工作日早上 7:30
# 注意：采集用的窗口 = WB_USAGE_DAYS（上面那行，上限 31）。

# 用量页的查询缓存秒数。同一窗口内重复刷新会复用缓存，避免打爆接口。
# 点页面「重新查询」会强制刷新（绕过缓存）。最小 5 秒。
WB_USAGE_CACHE_TTL=60

# ─── 推送通知（Server 酱 / 通用 Webhook）─────────────────────────
# 每次跑完把结果推到手机：每账号签到结果 + 派猫 + 连登兑换 + 当日积分消耗。
# 推送失败绝不影响签到结论，也不会改退出码。
#
# 总开关：0 = 完全不推送
WB_NOTIFY=1

# 推送时机：
#   always = 每次跑完都发（默认）
#   fail   = 只在有账号失败时发
#   change = 只在有积分变化时发
WB_NOTIFY_ON=always

# 【选填】Server 酱 Turbo。SENDKEY 在 https://sct.ftqq.com 免费申请，形如 SCTxxxxxx
# 配了就发，不配就静默跳过。多条通道可以同时配，会各发一遍。
# WB_SENDKEY=SCTxxxxxxxxxxxxxxxxxxxx

# 【选填】Server 酱³（新版）。完整 sendkey 形如 xxxxxxtxxxxxx（uid + t + key）
# WB_SENDKEY3=

# 【选填】通用 Webhook。钉钉 / 飞书 / Bark / 企业微信 等都行，POST JSON。
# WB_NOTIFY_WEBHOOK=https://example.com/hook
# 默认发 {"title","text","desp","markdown","content"} 五个字段（兼容各家常见形状）。
# 想完全自定义 JSON 就用模板（{title} / {desp} / {text} 三个占位符，值会做 JSON 转义）：
# WB_NOTIFY_WEBHOOK_TEMPLATE={"msgtype":"text","text":{"content":"{text}"}}

# 推送请求超时秒数（默认 8）
WB_NOTIFY_TIMEOUT=8

# 【选填】GitHub Token，只给控制台「更新」页查最新 commit 用（只读权限即可）。
# 不填也能查，只是匿名访问 GitHub API 有次数限制（每小时 60 次）。
# WB_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx

# ⚠️ 不要设置 WB_ACCOUNTS_JSON！它的优先级高于账号文件，
#    一旦设置会把 Web 界面添加的账号全部遮蔽掉。
#    账号请在 Web 控制台的「账号」页里添加。
